#!/bin/bash
set -euo pipefail

# Remove previous application bundle
rm -rf /Applications/dlmc-video-downloader.app

# Clean up stale local yt-dlp binary directory left by pre-v26.10 versions.
# The app no longer bundles or seeds a subprocess yt-dlp binary; this folder
# is safe to remove entirely.
for userdir in /Users/*/; do
    userdir="${userdir%/}"
    bin_dir="$userdir/Library/Application Support/DLMC Video Downloader/bin"
    if [ -d "$bin_dir" ]; then
        rm -rf "$bin_dir"
    fi
done

exit 0
