#!/bin/bash
set -euo pipefail

# Remove current and legacy application bundles
rm -rf /Applications/dlmc-video-downloader.app
rm -rf /Applications/dlmc-dlp.app

# Forget the legacy package receipt so pkgutil/JAMF no longer tracks it
if pkgutil --pkg-info "com.dlmc.dlmc-dlp" &>/dev/null; then
    pkgutil --forget "com.dlmc.dlmc-dlp" || true
fi

# Clean up stale local yt-dlp binary directory left by pre-v26.10 versions.
# The app no longer bundles or seeds a subprocess yt-dlp binary; this folder
# is safe to remove entirely.
for userdir in /Users/*/; do
    userdir="${userdir%/}"
    bin_dir="$userdir/Library/Application Support/DLMC Video Downloader/bin"
    if [ -d "$bin_dir" ]; then
        rm -rf "$bin_dir"
    fi
done

exit 0
